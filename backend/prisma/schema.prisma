// The full table-by-table contract is docs/tables.md. Feature specs that shaped
// each model are under docs/features/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StreamingService {
  SPOTIFY
  APPLE_MUSIC
  YOUTUBE
  TIDAL
  DEEZER
}

enum UserRole {
  USER
  ADMIN
}

/// The admin area's fixed list of presentation settings
/// (docs/features/admin-panel.md §3.2). A new key needs a new spec.
enum SettingKey {
  ANNOUNCEMENT
  ACCENT_COLOR
  WELCOME_TAGLINE
}

/// A member's role inside one community — unrelated to the app-wide UserRole.
/// Exactly one OWNER per community, enforced by the partial unique index
/// `community_members_one_owner` written by hand in the
/// `backfill_community_owners` migration (Prisma cannot express it).
enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

/// Whether a post links to one song or a whole album (docs/features/posts-feed.md §3).
enum PostKind {
  TRACK
  ALBUM
  /// A YouTube video kept as a video (docs/features/link-only-posts.md §4.2).
  VIDEO
  /// A SoundCloud set: an album, an EP or a playlist — SoundCloud's own word.
  SET
}

/// A platform whose links are shared without conversion
/// (docs/features/link-only-posts.md).
enum LinkPlatform {
  BANDCAMP
  SOUNDCLOUD
  YOUTUBE
}

/// docs/features/google-auth.md §3.
///
/// There is deliberately no email, no password hash, and no real name: Google's
/// `email` and `name` claims are read during verification and discarded
/// (CLAUDE.md §5). Never add one back without a new recorded decision.
///
/// The three profile columns are null until onboarding finishes — the row is
/// created at first sign-in, before the user has chosen anything.
model User {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The account key: Google's opaque, stable `sub` claim.
  googleSub               String                @unique @map("google_sub")
  /// Shown exactly as typed — any language, editable.
  displayName             String?               @map("display_name") @db.VarChar(50)
  /// Server-derived normalised form of displayName. Carries the uniqueness, so
  /// "Ofri" and "ofri " collide while each is still shown as typed. Never sent
  /// to a client.
  displayNameKey          String?               @unique @map("display_name_key") @db.VarChar(50)
  /// Google's photo URL. Kept only before onboarding (to offer it as a
  /// choice) or when the user chose it (docs/features/onboarding.md §3).
  profilePictureUrl       String?               @map("profile_picture_url")
  /// The user chose their Google photo as their avatar. False until they do.
  useGooglePicture        Boolean               @default(false) @map("use_google_picture")
  /// No default: "has not chosen" must stay distinguishable from "chose Spotify".
  preferredService        StreamingService?     @map("preferred_service")
  /// Set directly in the database, never through an API (CLAUDE.md §17).
  role                    UserRole              @default(USER)
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When Received was last opened; null until then. Never sent to a client
  /// (docs/features/direct-recommendations.md §3.1).
  recommendationsSeenAt   DateTime?             @map("recommendations_seen_at") @db.Timestamptz(3)
  memberships             CommunityMember[]
  bans                    CommunityBan[]        @relation("BannedUser")
  bansIssued              CommunityBan[]        @relation("BannedBy")
  settingChanges          SettingChange[]
  posts                   Post[]                @relation("PostAuthor")
  recommendationsReceived Post[]                @relation("PostRecipient")
  bookmarks               Bookmark[]
  ratings                 Rating[]
  friendRequestsSent      Friend[]              @relation("FriendRequester")
  friendRequestsReceived  Friend[]              @relation("FriendAddressee")
  invitations             CommunityInvitation[] @relation("InvitationInvitee")
  invitationsSent         CommunityInvitation[] @relation("InvitationInviter")
  notifications           Notification[]        @relation("NotificationReader")
  notificationsCaused     Notification[]        @relation("NotificationActor")

  @@map("users")
}

/// docs/features/communities-create.md §3.
///
/// There is no cover image column: covers are always generated from the name
/// and id (CLAUDE.md §8).
model Community {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Shown as typed. Not unique — communities are found by invite, never by name.
  name          String                @db.VarChar(100)
  /// Plain text with line breaks; null when the creator left it blank.
  description   String?
  /// The community's one invite link (docs/features/communities-invites.md §3).
  /// Created on first request, replaced on reset. A secret: never logged, never
  /// in PublicCommunity.
  inviteToken   String?               @unique @map("invite_token") @db.VarChar(64)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  members       CommunityMember[]
  bans          CommunityBan[]
  posts         Post[]
  invitations   CommunityInvitation[]
  notifications Notification[]

  @@map("communities")
}

/// One row per (user, community). The composite key makes a duplicate
/// membership impossible; cascades remove rows with either side.
model CommunityMember {
  userId      String        @map("user_id") @db.Uuid
  communityId String        @map("community_id") @db.Uuid
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId])
  @@map("community_members")
}

/// A user removed from a community, who cannot rejoin through any invite link
/// until an admin unblocks them (docs/features/communities-membership.md §3.2).
model CommunityBan {
  communityId String    @map("community_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// Who removed them; null if that admin's account is later deleted.
  bannedById  String?   @map("banned_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy    User?     @relation("BannedBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@id([communityId, userId])
  @@map("community_bans")
}

/// A music recommendation: to a community (UC-11, docs/features/posts-feed.md §3)
/// or to one friend (UC-20, docs/features/direct-recommendations.md §3). Exactly
/// one of `communityId` and `recipientId` is set, enforced by the hand-written
/// CHECK `posts_one_target`; `posts_not_self` stops a send to yourself (both in
/// the add_direct_recommendations migration; Prisma cannot express them, and
/// `prisma migrate diff` does not see them).
///
/// Metadata and links come from the link converter; all of them are null while
/// `conversionPending` is true. Every viewer is sent to their own service's
/// link, falling back to `originalUrl`.
model Post {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId             String            @map("author_id") @db.Uuid
  communityId          String?           @map("community_id") @db.Uuid
  /// The friend a direct recommendation was sent to.
  recipientId          String?           @map("recipient_id") @db.Uuid
  /// The recipient removed it from Received. Never serialised: the sender must
  /// not learn it. It affects Received only (§3.5).
  recipientHiddenAt    DateTime?         @map("recipient_hidden_at") @db.Timestamptz(3)
  /// Exactly as pasted (trimmed). Always present — the fallback link.
  originalUrl          String            @map("original_url") @db.VarChar(2048)
  /// The service a converted link came from. Null on a link-only post.
  sourceService        StreamingService? @map("source_service")
  /// Set on a link-only post, which is never converted. Exactly one of this
  /// and `sourceService` is set (`posts_one_source`, hand-written).
  linkPlatform         LinkPlatform?     @map("link_platform")
  kind                 PostKind?
  songTitle            String?           @map("song_title") @db.VarChar(300)
  songArtist           String?           @map("song_artist") @db.VarChar(300)
  songCoverArtUrl      String?           @map("song_cover_art_url") @db.VarChar(2048)
  universalLinkSpotify String?           @map("universal_link_spotify") @db.VarChar(2048)
  universalLinkApple   String?           @map("universal_link_apple") @db.VarChar(2048)
  /// squigly's YouTube Music link.
  universalLinkYoutube String?           @map("universal_link_youtube") @db.VarChar(2048)
  universalLinkTidal   String?           @map("universal_link_tidal") @db.VarChar(2048)
  universalLinkDeezer  String?           @map("universal_link_deezer") @db.VarChar(2048)
  textComment          String?           @map("text_comment")
  /// When the author last changed the comment; null if never. Shown as
  /// "· edited" (docs/features/edit-post-comment.md §3).
  commentEditedAt      DateTime?         @map("comment_edited_at") @db.Timestamptz(3)
  /// The conversion could not run (squigly down, timeout, unreadable page).
  conversionPending    Boolean           @default(false) @map("conversion_pending")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  author               User              @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  community            Community?        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// Cascade, because SetNull would break `posts_one_target`.
  recipient            User?             @relation("PostRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  bookmarks            Bookmark[]
  ratings              Rating[]
  notifications        Notification[]

  /// The feed: newest first in one community, keyset-paginated.
  @@index([communityId, createdAt(sort: Desc), id(sort: Desc)])
  /// Removing a member deletes their posts in that community.
  @@index([authorId, communityId])
  /// Received: newest first, keyset-paginated; also the recipient's cascade.
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  /// Sent: newest first, keyset-paginated.
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

/// A post saved to its user's Listen Later list (UC-12,
/// docs/features/bookmarks-my-list.md §3). Private to that user, and kept
/// when they leave or are removed from the post's community.
model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  /// My List: one user's bookmarks, newest saved first, keyset-paginated.
  @@index([userId, createdAt(sort: Desc), postId(sort: Desc)])
  /// Deleting a post cascades to its bookmarks by post id.
  @@index([postId])
  @@map("bookmarks")
}

/// One row per setting that has ever been changed; a missing row means the
/// default. `value` is validated in code against the setting's schema before
/// every write (docs/features/admin-panel.md §3.2).
model AppSetting {
  key       SettingKey @id
  value     Json
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

/// The settings history. Inserted, never updated or deleted by the app; an
/// entry outlives the admin's account (`changedById` set to null).
model SettingChange {
  id          String     @id @default(uuid()) @db.Uuid
  key         SettingKey
  oldValue    Json       @map("old_value")
  newValue    Json       @map("new_value")
  changedById String?    @map("changed_by_id") @db.Uuid
  changedAt   DateTime   @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedBy   User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([changedAt(sort: Desc)])
  @@map("setting_changes")
}

/// One member's rating of a post (UC-13, docs/features/rate-post.md §3).
/// Final once written. `score` is 1–10, enforced by Zod and by the
/// hand-written CHECK `ratings_score_range` in the add_ratings migration
/// (Prisma cannot express it, and `prisma migrate diff` does not see it).
model Rating {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int      @db.SmallInt
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set on every edit (docs/features/post-detail.md §3); not shown.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One rating per user per post; also serves "the ratings of a post".
  @@unique([postId, userId])
  /// A user's ratings, newest first: the profile's history
  /// (docs/features/find-people.md §3), `myScore`, and the account cascade.
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("ratings")
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

/// A friend request, and once accepted a friendship (UC-6, UC-7,
/// docs/features/friend-requests.md §3). One row per pair, in either direction:
/// the hand-written unique index `friends_one_per_pair` and CHECK
/// `friends_not_self` (in the add_friends migration; Prisma cannot express
/// them, and `prisma migrate diff` does not see them) guard it.
model Friend {
  requesterId String       @map("requester_id") @db.Uuid
  addresseeId String       @map("addressee_id") @db.Uuid
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set on every write; for an accepted row, when it was accepted.
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  /// The requester's side, and the cascade from the requester.
  @@id([requesterId, addresseeId])
  /// Incoming requests newest first, the badge count, and the addressee's cascade.
  @@index([addresseeId, status, createdAt(sort: Desc)])
  @@map("friends")
}

/// A pending invitation to join a community (UC-9's picker,
/// docs/features/invite-friends.md §3). Gone once accepted or declined.
model CommunityInvitation {
  communityId String    @map("community_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// The admin who sent it; null once their account is deleted.
  invitedById String?   @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation("InvitationInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  /// One invitation per person per community.
  @@id([communityId, userId])
  /// "My invitations" newest first, the badge count, and the invitee's cascade.
  @@index([userId, createdAt(sort: Desc)])
  /// The inviter's SET NULL.
  @@index([invitedById])
  @@map("community_invitations")
}

/// What a notification is about — docs/features/notifications.md §3 (UC-21).
enum NotificationType {
  /// New posts in one community, grouped while unread: `count`, latest poster as actor.
  COMMUNITY_POSTS
  /// A direct recommendation received (UC-20).
  RECOMMENDATION
  /// Someone rated the reader's post — the first rating only (UC-13).
  RATING
  /// Someone sent the reader a friend request (UC-6).
  FRIEND_REQUEST
  /// Someone accepted the reader's friend request (UC-7).
  FRIEND_ACCEPTED
  /// A community admin invited the reader (UC-9).
  COMMUNITY_INVITATION
  /// The reader was made an admin of a community (UC-14; role-notifications.md).
  COMMUNITY_ADMIN
  /// The reader was made the owner of a community (UC-14; role-notifications.md).
  COMMUNITY_OWNER
}

/// The in-app inbox — docs/features/notifications.md §3 (UC-21).
///
/// Hand-written in the add_notifications migration, invisible to Prisma: the
/// partial unique index `notifications_one_open_group` (one unread
/// COMMUNITY_POSTS row per reader and community, the grouping upsert's target)
/// and the CHECK `notifications_count_positive`.
///
/// What a reader may see is filtered when it is read (§4), never by deleting:
/// a former member's community rows simply stop showing.
model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The reader.
  userId      String           @map("user_id") @db.Uuid
  type        NotificationType
  /// Who did it; for COMMUNITY_POSTS, the latest poster.
  actorId     String           @map("actor_id") @db.Uuid
  /// COMMUNITY_POSTS and COMMUNITY_INVITATION.
  communityId String?          @map("community_id") @db.Uuid
  /// RECOMMENDATION and RATING.
  postId      String?          @map("post_id") @db.Uuid
  /// Above 1 only for a COMMUNITY_POSTS group.
  count       Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Bumped when a group grows; the list is ordered by it.
  updatedAt   DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  user        User             @relation("NotificationReader", fields: [userId], references: [id], onDelete: Cascade)
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  community   Community?       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)

  /// The list: one reader's rows, newest activity first, keyset-paginated.
  @@index([userId, updatedAt(sort: Desc), id(sort: Desc)])
  /// Cascades by actor, post and community.
  @@index([actorId])
  @@index([postId])
  @@index([communityId])
  @@map("notifications")
}
