# Copy to backend/.env and fill in. Never commit the real file.
#
#   cp backend/.env.example backend/.env

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Local Postgres from docker-compose.yml at the repository root.
# The integration-test suite uses music_app_test_db instead — never the dev database.
DATABASE_URL=postgresql://bookrough:bookrough@localhost:5433/music_app_dev

# Signing key for the session cookie. At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# OAuth 2.0 Client ID from the Google Cloud Console (type "Web application",
# authorised JavaScript origin http://localhost:5173).
# Must match VITE_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_CLIENT_ID=

# Exact origin allowed to call this API with credentials. Never a wildcard.
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# E2E only — leave empty. The Playwright suite sets it to the test key in
# e2e/fixtures/ so ID tokens are verified without Google
# (docs/features/auth-flow-e2e.md). The API refuses to start with it unless NODE_ENV=test.
E2E_GOOGLE_PUBLIC_KEY=

# E2E only — leave empty. The Playwright suite points it at
# e2e/fixtures/scraper-stand-in.json so posts convert without squigly.link
# (docs/features/posts-feed.md §4.2). The API refuses to start with it set
# unless NODE_ENV=test.
E2E_SCRAPER_FIXTURES=
