# ─── Database ────────────────────────────────────────────────────────────────

# Development database (used by `npm run dev` and `prisma migrate dev`)
DATABASE_URL=postgresql://bookrough:bookrough@localhost:5432/music_app_dev

# Separate DB for integration tests — never the same as DATABASE_URL
TEST_DATABASE_URL=postgresql://bookrough:bookrough@localhost:5432/music_app_test

# ─── Server ───────────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development     # development | production | test

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_BEFORE_RUNNING

# How long sessions last (jsonwebtoken format: 7d, 24h, 3600)
JWT_EXPIRES_IN=7d

# Your OAuth Client ID from Google Cloud Console (no secret needed — we use the id-token flow)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ─── Cookies ─────────────────────────────────────────────────────────────────

# Set to "true" in production (requires HTTPS). Use "false" for local dev.
COOKIE_SECURE=false

# Domain for the cookie — leave empty for localhost
COOKIE_DOMAIN=

# ─── CORS ─────────────────────────────────────────────────────────────────────

# The frontend origin Express allows — must match the Vite dev server URL
FRONTEND_ORIGIN=http://localhost:5173

# ─── Logging ─────────────────────────────────────────────────────────────────

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
