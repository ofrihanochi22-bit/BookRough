# Copy to backend/.env and fill in. Never commit the real file.
#
#   cp backend/.env.example backend/.env

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Local Postgres from docker-compose.yml at the repository root.
# The integration-test suite uses music_app_test_db instead — never the dev database.
DATABASE_URL=postgresql://bookrough:bookrough@localhost:5432/music_app_dev

# Signing key for the session cookie. At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Not used until Step 1.3, but required at boot so it is configured once.
JWT_SECRET=

# OAuth 2.0 Client ID from the Google Cloud Console.
# Not used until Step 1.3. Must match VITE_GOOGLE_CLIENT_ID on the frontend.
GOOGLE_CLIENT_ID=

# Exact origin allowed to call this API with credentials. Never a wildcard.
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
