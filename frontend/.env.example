# Copy to frontend/.env and fill in. Never commit the real file.
#
#   cp frontend/.env.example frontend/.env
#
# Anything prefixed VITE_ is embedded into the built bundle and is therefore
# PUBLIC. Never put a secret here — the Google Client ID is public by design,
# the client *secret* is not and is never used by this project.

# Base URL of the API, without a trailing slash. Optional: when empty, a
# production build uses the same-origin /api (frontend and API share one origin
# on Vercel - docs/features/production-deploy.md) and development uses
# http://localhost:4000/api. Leave it unset at the host.
VITE_API_BASE_URL=http://localhost:4000/api

# OAuth 2.0 Client ID from the Google Cloud Console (type "Web application",
# authorised JavaScript origin http://localhost:5173; production adds its own
# origin). Must match GOOGLE_CLIENT_ID on the backend. Set at the host for
# Production and Preview builds.
VITE_GOOGLE_CLIENT_ID=
