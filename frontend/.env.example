# ─── API ──────────────────────────────────────────────────────────────────────

# The base URL all axios requests are prefixed with.
# In dev, Vite proxies /api to this origin so cookies work on the same port.
VITE_API_BASE_URL=http://localhost:4000

# ─── Google OAuth ─────────────────────────────────────────────────────────────

# Must match the Client ID in backend/.env  (no secret on the frontend)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
