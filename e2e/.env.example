# Copy to .env and fill in values before running E2E tests.
# The E2E suite uses the same test DB as backend integration tests.

# postgres:// connection string for the test database (resets between spec runs)
TEST_DATABASE_URL=postgres://bookrough:bookrough@localhost:5432/music_app_test_db

# Base URL of the running frontend dev server
BASE_URL=http://localhost:5173

# Base URL of the running backend dev server
BACKEND_URL=http://localhost:4000
